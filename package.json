{
  "name": "print-order",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "next dev -p 3000 -H 127.0.0.1",
    "build": "next build && node scripts/migrate.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "seed:demo": "node scripts/seed-demo.mjs",
    "seed:tenant": "node --experimental-strip-types scripts/seed-tenant.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:probe": "node tests/probe-audit.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "next": "^15.1.6",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
